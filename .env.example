# Local development. For Telegram use the production values described in README.md.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
ALLOW_GUESTS=true
# Production requires a real HTTPS origin, bot token and bot username.
PUBLIC_URL=
BOT_TOKEN=
BOT_USERNAME=
# Leave empty for the main Mini App; set only for a named direct-link Mini App.
TELEGRAM_APP_NAME=
# Docker: /app/data; otherwise defaults to ./data
DATA_DIR=./data
